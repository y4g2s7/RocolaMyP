<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.TituloWindow"
	xmlns:models="using:Interfaz.Models"
	x:DataType="models:Titulo"
	Title="Información"
	Width="500" Height="400"
        Background="#2B1D14">
  <DockPanel>
  
    <StackPanel DockPanel.Dock="Top" Margin="20">
      
      <TextBlock Text="Presiona para editar"
		 Foreground="#FFFFFF" 
                 Margin="0,0,0,8"
		 HorizontalAlignment="Center"/>
   
    </StackPanel>


    <StackPanel DockPanel.Dock="Bottom" Margin="20, 0, 20, 20">
        <Button Content="SALIR" 
                HorizontalAlignment="Right" 
                HorizontalContentAlignment="Center"
                Background="#8A3220" 
                Foreground="#F5F5DC" 
                Padding="10"/>
    </StackPanel>
    
    <Grid ColumnDefinitions="Auto, *" Margin="20">

      <StackPanel Grid.Column="0" 
                  Orientation="Vertical" 
                  Spacing="4" 
                  VerticalAlignment="Center"
                  Margin="0,0,7,0"> <!-- Margen a la derecha para separar del texto -->
        
        <!-- Nota: Asegúrate de tener estas imágenes en tu carpeta Assets -->
        <Image Source="avares://Interfaz/Assets/notas.png" Width="50" Height="50" />
        <Image Source="avares://Interfaz/Assets/track.png" Width="55" Height="55" />
        <Image Source="avares://Interfaz/Assets/calendario.png" Width="70" Height="70" />
        <Image Source="avares://Interfaz/Assets/genero.png" Width="85" Height="55" />
      </StackPanel>
        <!-- Botones en la segunda columna -->
        <StackPanel Grid.Column="1" 
                    Orientation="Vertical" 
                    Spacing="18"
                    VerticalAlignment="Center">
	  
	    <Button Content="{Binding titulo, StringFormat='Título: {0}'}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#4E342E" 
                    Foreground="#F5F5DC" 
                    Padding="10"/>
	    
            <Button Content="{Binding track, StringFormat='Track: {0}'}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#4E342E" 
                    Foreground="#F5F5DC" 
                    Padding="10"/>
	    
            <Button Content="{Binding year, StringFormat='Año: {0}'}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#4E342E"
		    Foreground="#F5F5DC" 
                    Padding="10"/>
	    
            <Button Content="{Binding genero, StringFormat='Género: {0}'}"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#4E342E" 
                    Foreground="#F5F5DC" 
                    Padding="10"/>
	    
            
	</StackPanel>
    </Grid>
  </DockPanel>
  
</Window>
