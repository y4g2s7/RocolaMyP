<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.TituloWindow"
	xmlns:models="using:Interfaz.Models"
	x:DataType="models:Titulo"
	Title="Información"
	Width="300" Height="400"
        Background="#2B1D14">
  <StackPanel VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Spacing="15" 
                Width="200">

        <!-- Los 5 botones con tu estilo café -->
        <Button Content="{Binding titulo}" 
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10"/>

        <Button Content="{Binding track}" 
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10"/>

        <Button Content="{Binding year}" 
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#4E342E"
		Foreground="#F5F5DC" 
                Padding="10"/>

        <Button Content="{Binding genero}"
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10"/>

        <Button Content="SALIR" 
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10"/>

    </StackPanel>
  
</Window>
