<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Interfaz.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Interfaz">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">

      <Button Content="Minar"
              Margin="4"
              Click="AbrirVentanaMinar"/>
      
      <Button Content="Registrar Artista"
              Margin="4"
              Click="RegistrarArtistaClick"/>
    </StackPanel>
    
    <!-- Barra para la cancion actual -->
    <Border DockPanel.Dock="Bottom"
            Padding="15, 10"  
            BorderThickness="0,1,0,0"
            BorderBrush="#FFFFFF"       
            Background="#2B1D14">
      
	<!-- Grid de 3 columnas -->
	<Grid ColumnDefinitions="Auto, Auto *">
          
          <!-- La Imagen en la primera columna -->
          <Image Grid.Column="0" 
		 Source="avares://Interfaz/Assets/disco.png"
		 Width="120" 
		 Height="120" 
		 Stretch="UniformToFill"
		 Margin="0,0,15,0"
		 VerticalAlignment="Center"/>
	  <!-- Columna 1: NUEVA - Iconos pequeños apilados -->
        <StackPanel Grid.Column="1" 
                    Orientation="Vertical" 
                    Spacing="8" 
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"> <!-- Margen a la derecha para separar del texto -->
            
            <!-- Nota: Asegúrate de tener estas imágenes en tu carpeta Assets -->
            <Image Source="avares://Interfaz/Assets/notas.png" Width="40" Height="40" />
            <Image Source="avares://Interfaz/Assets/microfono.png" Width="35" Height="45" />
            <Image Source="avares://Interfaz/Assets/carpeta.png" Width="45" Height="45" />
        </StackPanel>
          <!-- Botones en la segunda columna -->
          <StackPanel Grid.Column="2" 
                      Orientation="Vertical" 
                      Spacing="18"
                      VerticalAlignment="Center">
	    
            <!-- Boton para el titulo de la cancion -->
            <Button Content="{Binding CancionSeleccionada.titulo}"
                    MinWidth="1"
                    FontSize="18"
                    Click="TituloClick"
                    Padding="6,6"
		    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Left" /> 
                    
            <Button Content="{Binding CancionSeleccionada.performer}"
                    MinWidth="1"
                    FontSize="15"
                    Click="PerformerClick"
                    Padding="6,6"
                    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Left" />
                    
            <Button Content="{Binding CancionSeleccionada.album}"
                    MinWidth="1"
                    FontSize="12"
                    Click="AlbumClick"
                    Padding="6,6"
                    Background="Transparent" 
                    BorderThickness="0"
                    HorizontalAlignment="Left" />
          </StackPanel>
	</Grid>
      </Border>
      <!-- Lista principal de las canciones conectada con la
	   ObservableCollection<CancionFila> canciones de MainWindowViewModel	   
	   Avisamos de la cancion seleccionada para la barra de abajo -->
      <DataGrid ItemsSource="{Binding canciones}" 
	      SelectedItem="{Binding CancionSeleccionada, Mode=TwoWay}"
	      AutoGenerateColumns="False"
	      IsReadOnly="True"
	      GridLinesVisibility="Horizontal" 
              HorizontalGridLinesBrush="#4D3E32"
	      Background="#735D4B"      
	      RowBackground="#735D4B"           
	      Foreground="#FFFFFF">
      <!-- Estilos -->
      <DataGrid.Styles>
	<!-- Centra el texto de los encabezados -->
	<Style Selector="DataGridColumnHeader">
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
	   <Setter Property="Background" Value="#3D3128"/> 
           <Setter Property="Foreground" Value="#F5F5DC"/> 
	</Style>
	
	<!-- Centra el texto de las celdas -->
	<Style Selector="DataGridCell TextBlock">
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
      </DataGrid.Styles>

      <DataGrid.Columns>
	<DataGridTextColumn Header="Título"  Width="*"  Binding="{Binding titulo}"/>
	<DataGridTextColumn Header="Artista" Width="*"  Binding="{Binding performer}"/>
	<DataGridTextColumn Header="Álbum"   Width="*"  Binding="{Binding album}"/>
	<DataGridTextColumn Header="Género"  Width="*"  Binding="{Binding genero}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
