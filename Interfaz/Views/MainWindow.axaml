<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Interfaz.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Interfaz">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Button DockPanel.Dock="Top"
            Content="Minar"
            Margin="8"
            Click="AbrirVentanaMinar"/>

    <Border DockPanel.Dock="Bottom"
            Padding="30"
            BorderThickness="0,1,0,0"
            BorderBrush="Gray">
      <StackPanel Orientation="Vertical" Spacing="16">
	<Button Content="{Binding CancionSeleccionada.titulo}"
		MinWidth="1"
		FontSize="16"
		Click="TituloClick"
		Padding="6,6"/>
	<Button Content="{Binding CancionSeleccionada.performer}"
		MinWidth="1"
		FontSize="13"
		Click="PerformerClick"
		Padding="6,6"/>
	<Button Content="{Binding CancionSeleccionada.album}"
		MinWidth="1"
		FontSize="10"
		Click="AlbumClick"
		Padding="6,6"/>
      </StackPanel>
    </Border>
    <DataGrid ItemsSource="{Binding canciones}"
	      SelectedItem="{Binding CancionSeleccionada, Mode=TwoWay}"
	      AutoGenerateColumns="False"
	      IsReadOnly="True"
	      GridLinesVisibility="Horizontal" 
              HorizontalGridLinesBrush="#333333">
      <!-- Estilos -->
      <DataGrid.Styles>
	<!-- Centra el texto de los encabezados -->
	<Style Selector="DataGridColumnHeader">
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
	</Style>
	
	<!-- Centra el texto de las celdas -->
	<Style Selector="DataGridCell TextBlock">
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
      </DataGrid.Styles>

      <DataGrid.Columns>
	<DataGridTextColumn Header="Título"  Width="*"  Binding="{Binding titulo}"/>
	<DataGridTextColumn Header="Artista" Width="*"  Binding="{Binding performer}"/>
	<DataGridTextColumn Header="Álbum"   Width="*"  Binding="{Binding album}"/>
	<DataGridTextColumn Header="Género"  Width="*"  Binding="{Binding genero}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
