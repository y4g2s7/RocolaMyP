<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.BarraCancionActual.Albums.AlbumWindow"
        xmlns:models="using:Interfaz.Models"
        x:DataType="models:Album"
        Title="Album"
        Width="500" Height="500"
        Background="#2B1D14">
  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Margin="20">
      <TextBlock Text="Presiona para editar"
                 Foreground="#FFFFFF" 
                 Margin="0,0,0,8"
                 HorizontalAlignment="Center"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                HorizontalAlignment="Right" Spacing="10" Margin="20, 0, 20, 20">
      <Button Content="GUARDAR" 
              Click="GuardarClick"
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10,10"/>
      <Button Content="SALIR" 
                Click="CerrarVentana" 
                HorizontalContentAlignment="Center"
                Background="#8A3220" 
                Foreground="#F5F5DC" 
                Padding="10"/>
    </StackPanel>
    
    <StackPanel VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Spacing="10">

        <Image Source="avares://Interfaz/Assets/album.png" 
               Width="200" Height="200" 
               HorizontalAlignment="Center"/>

        <StackPanel Spacing="10" Width="300">
        
          <TextBlock Text="Nombre:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding nombre, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>
        
	    <TextBlock Text="Año:" Foreground="#F5F5DC" FontWeight="Bold"/>
	    <NumericUpDown Value="{Binding year, Mode=TwoWay}"
		       ShowButtonSpinner="False"
		       AllowSpin="False"
		       Background="#4E342E" 
		       Foreground="#F5F5DC"
		       HorizontalContentAlignment="Center"/>

	<!-- Para el Año -->
        </StackPanel>

    </StackPanel>
  </DockPanel>
</Window>
