<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.BarraCancionActual.Albums.AlbumWindow"
        xmlns:models="using:Interfaz.Models"
        x:DataType="models:Album"
        Title="Album"
        Width="500" Height="400"
        Background="#2B1D14">
  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Margin="20">
      <TextBlock Text="Presiona para editar"
                 Foreground="#FFFFFF" 
                 Margin="0,0,0,8"
                 HorizontalAlignment="Center"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="20, 0, 20, 20">
        <Button Content="SALIR" 
                Click="CerrarVentana"
                HorizontalAlignment="Right" 
                HorizontalContentAlignment="Center"
                Background="#8A3220" 
                Foreground="#F5F5DC" 
                Padding="10"/>
    </StackPanel>
    
    <StackPanel VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Spacing="20">

        <Image Source="avares://Interfaz/Assets/album.png" 
               Width="200" Height="200" 
               HorizontalAlignment="Center"/>

        <StackPanel Spacing="15" Width="300">
            <Button Content="{Binding nombre, StringFormat='Nombre: {0}'}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#4E342E" 
                    Foreground="#F5F5DC" 
                    Padding="10"/>
        
            <Button Content="{Binding year, StringFormat='Año: {0}'}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#4E342E" 
                    Foreground="#F5F5DC" 
                    Padding="10"/>
        </StackPanel>

    </StackPanel>
  </DockPanel>
</Window>
