<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.BarraCancionActual.Artistas.PersonaWindow"
        Title="Persona"
	xmlns:models="using:Interfaz.Models"
	x:DataType="models:Artista"
	Width="600" Height="500"
	Background="#2B1D14">
  <DockPanel>
    
    <StackPanel DockPanel.Dock="Top" Margin="10">
      
      <TextBlock Text="Presiona para editar"
		 Foreground="#FFFFFF" 
                 Margin="0,0,0,8"
		 HorizontalAlignment="Center"/>
      
    </StackPanel>


    
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                HorizontalAlignment="Right" Spacing="10" Margin="20, 0, 20, 20">
        <Button Content="GUARDAR" 
                Click="GuardarClick"
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10,10"/>
        <Button Content="SALIR" 
                Click="CerrarVentana"
                HorizontalContentAlignment="Center"
                Background="#8A3220" 
                Foreground="#F5F5DC" 
                Padding="10,10"/>
    </StackPanel>
    
    <Grid ColumnDefinitions="Auto, *" Margin="20">

      <StackPanel Grid.Column="0" 
                  Orientation="Vertical" 
                  Spacing="4" 
                  VerticalAlignment="Center"
                  Margin="0,0,7,0">
        
        <!-- Imagenes en la carpeta Assets -->
        
        <Image Source="avares://Interfaz/Assets/persona.png" Width="150" Height="155" />
      </StackPanel>
      <!-- Botones en la segunda columna -->
      <StackPanel Grid.Column="1" 
                  Orientation="Vertical" 
                  Spacing="8"
                  VerticalAlignment="Center">
	
	<TextBlock Text="Seudonimo:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding seudonimo, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>
	    
	    <TextBlock Text="Nombre Real:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding nombreA, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>

	    <TextBlock Text="Nacimiento:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding cumpleañosA, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>

	    <TextBlock Text="Muerte:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding muerteA, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>
        
      </StackPanel>
    </Grid>
  </DockPanel>
  
</Window>

