<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Interfaz.Views.BarraCancionActual.Title.TituloWindow"
        xmlns:models="using:Interfaz.Models"
        x:DataType="models:Titulo"
        Title="Información"
        Width="500" Height="450"
        Background="#2B1D14">
  <DockPanel>
  
    <StackPanel DockPanel.Dock="Top" Margin="20">
      <TextBlock Text="Edita los datos de la canción"
                 Foreground="#FFFFFF" 
                 Margin="0,0,0,8"
                 HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- Botones de acción abajo -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                HorizontalAlignment="Right" Spacing="10" Margin="20, 0, 20, 20">
        <Button Content="GUARDAR" 
                Click="GuardarClick"
                HorizontalContentAlignment="Center"
                Background="#4E342E" 
                Foreground="#F5F5DC" 
                Padding="10,10"/>
        <Button Content="SALIR" 
                Click="CerrarVentana"
                HorizontalContentAlignment="Center"
                Background="#8A3220" 
                Foreground="#F5F5DC" 
                Padding="10,10"/>
    </StackPanel>
    
    <Grid ColumnDefinitions="Auto, *" Margin="20">

      <!-- Imágenes -->
      <StackPanel Grid.Column="0" 
                  Orientation="Vertical" 
                  Spacing="10" 
                  VerticalAlignment="Center"
                  Margin="0,0,15,0">
        <Image Source="avares://Interfaz/Assets/notas.png" Width="50" Height="50" />
        <Image Source="avares://Interfaz/Assets/track.png" Width="60" Height="60" />
        <Image Source="avares://Interfaz/Assets/calendario.png" Width="70" Height="70" />
        <Image Source="avares://Interfaz/Assets/genero.png" Width="65" Height="65" />
      </StackPanel>

      <!-- Cajas de texto con su etiqueta -->
      <StackPanel Grid.Column="1" 
                  Orientation="Vertical" 
                  Spacing="10"
                  VerticalAlignment="Center">
	  
        <!-- Título -->
        <StackPanel Spacing="2">
            <TextBlock Text="Título:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding titulo, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>
        </StackPanel>

	<!-- Para el Track -->
	<TextBlock Text="Track:" Foreground="#F5F5DC" FontWeight="Bold"/>
	<NumericUpDown Value="{Binding track, Mode=TwoWay}"
		       ShowButtonSpinner="False"
		       AllowSpin="False"
		       Background="#4E342E" 
		       Foreground="#F5F5DC"
		       HorizontalContentAlignment="Center"/>

	<!-- Para el Año -->
	<TextBlock Text="Año:" Foreground="#F5F5DC" FontWeight="Bold"/>
	<NumericUpDown Value="{Binding year, Mode=TwoWay}"
		       ShowButtonSpinner="False"
		       AllowSpin="False"
		       Background="#4E342E" 
		       Foreground="#F5F5DC"
		       HorizontalContentAlignment="Center"/>
        <!-- Género -->
        <StackPanel Spacing="2">
            <TextBlock Text="Género:" Foreground="#F5F5DC" FontWeight="Bold"/>
            <TextBox Text="{Binding genero, Mode=TwoWay}" 
                     Background="#4E342E" 
                     Foreground="#F5F5DC" 
                     Padding="10"
                     HorizontalContentAlignment="Center"/>
        </StackPanel>
	    
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
